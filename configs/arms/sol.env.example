# Arm: sol — GPT 5.6 Sol via Azure OpenAI deployment.
# Paste into this Mac's credentials.env (replaces the model block).
# VERIFIED 2026-08-06 against the Azure AI model catalog
# (ai.azure.com/catalog/models/gpt-5.6-sol, version 2026-07-09): context
# window 1,050,000 tokens (922K input + 128K output), max output 128,000.
FB_ARM="sol"
MODEL_ID="gpt-5.6-sol"
# Azure v1 surface. The proxy sends both Bearer and api-key headers, and
# rewrites max_tokens → max_completion_tokens for *.azure.com automatically.
MODEL_UPSTREAM_URL="https://YOUR-RESOURCE.openai.azure.com/openai/v1"
MODEL_API_KEY=""
# Responses API (reasoning summaries in the trace) — OpenAI/Azure only.
MODEL_NPM="@ai-sdk/openai"
# MODEL_CONTEXT/MODEL_OUTPUT intentionally unset → OpenCode defaults (fleet
# policy: only muse pins limits, since Meta publishes them as part of its
# recommended OpenCode config). Documented caps for reference: 1,050,000 ctx
# / 128,000 out.
