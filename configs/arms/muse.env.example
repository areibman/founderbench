# Arm: muse — Meta "muse-spark-1.2-contributor" (contributor-tier Muse Spark 1.2),
# direct Meta key on the Meta Model API.
# Paste into this Mac's credentials.env (replaces the model block and the
# Inkbox identity block).
# VERIFIED 2026-08-06 against https://llama.developer.meta.com/docs/overview:
#   base URL https://api.meta.ai/v1, Bearer auth, contributor-tier model id
#   muse-spark-1.2-contributor, context 1,048,576 / output 131,072.
FB_ARM="muse"
MODEL_ID="muse-spark-1.2-contributor"
MODEL_UPSTREAM_URL="https://api.meta.ai/v1"
MODEL_API_KEY=""   # META_AI_API_KEY
# Meta's docs recommend the Responses API for agent harnesses (reasoning replay
# across turns) and publish these exact OpenCode provider settings.
MODEL_NPM="@ai-sdk/openai"
MODEL_OPTIONS_JSON='{"reasoningEffort":"high","reasoningSummary":"auto","include":["reasoning.encrypted_content"]}'
MODEL_CONTEXT=1048576
MODEL_OUTPUT=131072

# ── Inkbox identity (PER-AGENT — this Mac's agent, never shared) ──────────────
# Same three fields as the Inkbox section of credentials.env.example, kept in
# every arm file so one paste provisions the whole per-machine block. Use an
# identity-scoped key (stage 60 asserts exactly 1 identity is visible).
INKBOX_API_KEY=""
INKBOX_VAULT_KEY=""     # client-side vault decryption key — Inkbox cannot recover it
INKBOX_AGENT_HANDLE=""  # e.g. "founderbench-muse"
