# Arm: gemini — Gemini 3.6 Flash, direct Google key on the OpenAI-compat surface.
# Paste into this Mac's credentials.env (replaces the model block).
# VERIFIED 2026-08-06 against ai.google.dev/gemini-api/docs/openai and the
# gemini-3.6-flash model page: stable model id gemini-3.6-flash, base URL
# https://generativelanguage.googleapis.com/v1beta/openai (Bearer auth works),
# context 1,048,576 / output 65,536, function calling + structured outputs
# supported over chat completions.
FB_ARM="gemini"
MODEL_ID="gemini-3.6-flash"
MODEL_UPSTREAM_URL="https://generativelanguage.googleapis.com/v1beta/openai"
MODEL_API_KEY=""   # GEMINI_API_KEY
MODEL_NPM="@ai-sdk/openai-compatible"
# MODEL_CONTEXT/MODEL_OUTPUT intentionally unset → OpenCode defaults (fleet
# policy: only muse pins limits). Documented caps for reference: 1,048,576
# ctx / 65,536 out.
