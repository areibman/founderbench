# FounderBench bootstrap credentials.
# Copy to <repo-root>/credentials.env and fill in. credentials.env is gitignored;
# never commit real values.
#
# This file is the SINGLE place environment variables are set. Everything reads
# it: machine/*.sh stages source it via load_credentials, run-daemon.sh sources
# it under launchd, and the orchestrator loads it into process.env at startup
# (OpenCode and the interception proxy inherit from there). Real environment
# variables override the file.
#
# Every value below is PER-AGENT unless marked shareable. The agent also holds
# copies of its operational logins in its Inkbox vault (that is ITS credential
# store, for signing back into accounts it creates); this file is what the
# harness itself reads.

# ── Model provider (PER-ARM) ──────────────────────────────────────────────────
# Each Mac runs one arm. Replace this whole block with the arm's template from
# configs/arms/<arm>.env.example. Azure deployments, OpenRouter, and plain
# provider keys all collapse to this same shape: the interception proxy
# forwards to MODEL_UPSTREAM_URL with Bearer $MODEL_API_KEY (plus Azure's
# api-key header and max_completion_tokens rewrite when the host is Azure).
FB_ARM="sol"
MODEL_ID="gpt-5.6-sol"
MODEL_UPSTREAM_URL="https://YOUR-RESOURCE.openai.azure.com/openai/v1"
MODEL_API_KEY=""
# OpenCode provider package (stage 70 renders it into ~/opencode.json):
# "@ai-sdk/openai" for OpenAI/Azure (Responses API, reasoning summaries),
# "@ai-sdk/openai-compatible" for every other upstream (Chat Completions).
MODEL_NPM="@ai-sdk/openai"

# ── Inkbox bootstrap ──────────────────────────────────────────────────────────
# Unique identity-scoped API key for this agent. Never use an admin-scoped key.
INKBOX_API_KEY=""
# Client-side vault decryption key. Inkbox cannot recover this value.
INKBOX_VAULT_KEY=""
# Identity handle bound to INKBOX_API_KEY, for example "founderbench-a".
INKBOX_AGENT_HANDLE=""

# ── Money (PER-AGENT — a value shared across two Macs destroys arm isolation) ─
# Stripe: this agent's own member account, standard sk_live_ key. NOT the org
# key (sk_org_ grants the whole fleet), NOT a restricted rk_ key (passes
# /v1/account but fails payment_links/payouts mid-run). Stage 60 gates on
# charges_enabled + empty requirements.currently_due.
STRIPE_API_KEY=""
# meow bank: dashboard-issued key with "Restrict to one bank account" ON.
# Stage 60 asserts exactly one account is visible through it.
MEOW_API_TOKEN=""

# ── Research / browser (shareable across Macs) ────────────────────────────────
EXA_API_KEY=""
BROWSERBASE_API_KEY=""
BROWSERBASE_PROJECT_ID=""

# ── Machine plumbing ──────────────────────────────────────────────────────────
# Password for the dedicated build keychain (stage 50 creates it; run-daemon.sh
# and the orchestrator unlock it with this at every launch).
FB_KEYCHAIN_PASSWORD=""
# macOS account password for self-KVM auth sheets (vncdotool skill). Leave
# empty if the agent account has no password.
MACOS_ACCOUNT_PASSWORD=""
# Optional: pin the Xcode version stage 20 enforces (e.g. "16.4").
XCODE_VERSION=""

# ── App Store Connect (OPTIONAL — leave empty; iOS is an unprovisioned escape
#    hatch, checklist 4.1-4.3. Only fill for a signing-enabled machine.) ───────
ASC_KEY_ID=""
ASC_ISSUER_ID=""
ASC_PRIVATE_KEY_PATH=""
APPLE_TEAM_ID=""
APPLE_CERT_P12=""
APPLE_CERT_P12_PASSWORD=""
